# =====================================================
# AI SCHOOL DASHBOARD - FRONTEND SAMPLE ENV
# =====================================================
# Copy this file to `.env` (or `.env.local`) and replace placeholders.
# ALL variables prefixed with REACT_APP_ are embedded in the bundle.

# =====================================================
# API CONFIGURATION
# =====================================================
REACT_APP_API_URL=http://localhost:5000/api

# =====================================================
# APPLICATION METADATA
# =====================================================
REACT_APP_NAME=AI School Dashboard
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# =====================================================
# FEATURE FLAGS
# =====================================================
REACT_APP_ENABLE_AI_FEATURES=true

# =====================================================
# OPTIONAL THIRD-PARTY INTEGRATIONS
# =====================================================
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn

# =====================================================
# SECURITY NOTES
# =====================================================
# 1. Do NOT place secrets or private keys in frontend env files.
# 2. Rotate backend secrets immediately if a frontend env leaked sensitive data.
# 3. Backend must enforce authentication/authorization regardless of these values.
