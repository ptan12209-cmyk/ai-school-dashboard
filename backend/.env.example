# =====================================================
# AI SCHOOL DASHBOARD - BACKEND SAMPLE ENV
# =====================================================
# Copy this file to `.env` and replace placeholder values
# NEVER commit the populated `.env` file to version control.

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_dashboard
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Optional: connection URL form
# DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/school_dashboard

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
HOST=0.0.0.0

# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_with_crypto_random_bytes
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Session Secret
SESSION_SECRET=generate_with_crypto_random_bytes
BCRYPT_ROUNDS=12

# =====================================================
# AI SERVICE CONFIGURATION
# =====================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# Python AI Microservice (if using separate service)
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS=25000

# =====================================================
# EMAIL CONFIGURATION (Notifications)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="School Dashboard" <noreply@school.edu.vn>

# =====================================================
# SMS CONFIGURATION (Twilio - optional)
# =====================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# CORS CONFIGURATION
# =====================================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# =====================================================
# FRONTEND CONFIGURATION (for React)
# =====================================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=development

# =====================================================
# DOCKER CONFIGURATION (optional)
# =====================================================
POSTGRES_VERSION=16
NODE_VERSION=20

# =====================================================
# TESTING CONFIGURATION
# =====================================================
TEST_DB_NAME=school_dashboard_test
TEST_PORT=5001

# =====================================================
# DEPLOYMENT CONFIGURATION (production only)
# =====================================================
# PROD_DB_URL=postgresql://user:password@prod-host:5432/db_name
# PROD_DOMAIN=https://school-dashboard.com
# SENTRY_DSN=https://your-sentry-dsn

# =====================================================
# SECURITY NOTES
# =====================================================
# 1. Rotate secrets immediately if this file was previously committed.
# 2. Use a secret manager (Vault, AWS Secrets Manager, etc.) in production.
# 3. Do not reuse the same secrets between environments.
# 4. Run `npm run test` before deploying changes.
