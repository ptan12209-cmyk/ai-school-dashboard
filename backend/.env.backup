# =====================================================
# AI SCHOOL DASHBOARD - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and update with your values
# WARNING: Never commit .env file to version control!

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_dashboard
DB_USER=postgres
DB_PASSWORD=hotanphat
RATE_LIMIT_MAX_REQUESTS=1000

# Alternative: Connection URL format
# DATABASE_URL=postgresql://postgres:password@localhost:5432/school_dashboard

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
HOST=0.0.0.0

